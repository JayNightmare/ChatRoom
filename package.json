{
  "name": "chatroom-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "concurrently -n server,web -c red,cyan \"pnpm --filter @chatroom/server dev\" \"pnpm --filter @chatroom/web dev\"",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.3.2"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true
  }
}
